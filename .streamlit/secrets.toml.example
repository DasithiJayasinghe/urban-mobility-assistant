# Copy this file to .streamlit/secrets.toml for local development.
# Set the same values in your Streamlit deployment's Secrets settings.
GROQ_API_KEY = "replace-with-a-new-groq-api-key"

# Required only when the taxi Parquet files are stored outside this repository.
# Use a path available to the deployment environment.
# TAXI_PARQUET_PATH = "/path/to/cleaned_taxi_dataset.parquet/*.parquet"
